{
  "systemCmd": "checkupdates 2>/dev/null",
  "aurCmd": "yay -Qua 2>/dev/null",
  "updateCmd": "kitty -- zsh -ic 'yay -Syu; flatpak update; echo; read -k1 \"?Press any key to exit...\"'",
  "aurHomepageCmd": "yay -Si {id} 2>/dev/null | awk '/^URL/ {print $3; exit}'",
  "flatpak": true,
  "noctalia": true,
  "toast": true,
  "desktopTip": true,
  "hideOnEmpty": false,
  "refreshTimer": false,
  "refreshInterval": 720,
  "iconName": "arrow-big-down-lines",
  "useDistroLogo": true,
  "customIconPath": "",
  "boldText": true,
  "enableColorization": false,
  "iconColor": "none",
  "boldVer": true,
  "tooltip": true,
  "closeButton": true,
  "closeOnSettings": false,
  "panelTooltip": true,
  "panelContext": true,
  "boldVerPanel": true,
  "boldVerDesktop": true,
  "hoverTip": true
}
